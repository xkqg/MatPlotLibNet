{
  "metadata": [
    {
      "src": [
        {
          "files": [
            "Src/MatPlotLibNet/MatPlotLibNet.csproj",
            "Src/MatPlotLibNet.Skia/MatPlotLibNet.Skia.csproj",
            "Src/MatPlotLibNet.Blazor/MatPlotLibNet.Blazor.csproj",
            "Src/MatPlotLibNet.AspNetCore/MatPlotLibNet.AspNetCore.csproj",
            "Src/MatPlotLibNet.Interactive/MatPlotLibNet.Interactive.csproj",
            "Src/MatPlotLibNet.GraphQL/MatPlotLibNet.GraphQL.csproj",
            "Src/MatPlotLibNet.DataFrame/MatPlotLibNet.DataFrame.csproj",
            "Src/MatPlotLibNet.Avalonia/MatPlotLibNet.Avalonia.csproj",
            "Src/MatPlotLibNet.Geo/MatPlotLibNet.Geo.csproj",
            "Src/MatPlotLibNet.Notebooks/MatPlotLibNet.Notebooks.csproj",
            "Src/MatPlotLibNet.Uno/MatPlotLibNet.Uno.csproj"
          ],
          "src": ".."
        }
      ],
      "dest": "api",
      "includePrivateMembers": false,
      "properties": {
        "TargetFramework": "net8.0"
      }
    },
    {
      "_comment": "MCP server metadata block — MatPlotLibNet.Mcp targets net10.0 only (a dotnet tool is resolved through the .NET 10 SDK), so it cannot ride the net8.0 block above.",
      "src": [
        {
          "files": [
            "Src/MatPlotLibNet.Mcp/MatPlotLibNet.Mcp.csproj"
          ],
          "src": ".."
        }
      ],
      "dest": "api",
      "includePrivateMembers": false,
      "properties": {
        "TargetFramework": "net10.0"
      }
    },
    {
      "_comment": "WPF metadata block — re-enabled 2026-04-19 after MatPlotLibNet.Wpf.csproj added <EnableWindowsTargeting Condition=\"'$(OS)' != 'Windows_NT'\">true</EnableWindowsTargeting>. DocFX can now extract net8.0-windows10.0.19041.0 metadata on Linux CI without installing the Windows desktop runtime.",
      "src": [
        {
          "files": [
            "Src/MatPlotLibNet.Wpf/MatPlotLibNet.Wpf.csproj"
          ],
          "src": ".."
        }
      ],
      "dest": "api",
      "includePrivateMembers": false,
      "properties": {
        "TargetFramework": "net8.0-windows10.0.19041.0"
      }
    }
  ],
  "build": {
    "content": [
      { "files": ["api/**.yml", "api/index.md"] },
      { "files": ["cookbook/**.md", "cookbook/toc.yml"] },
      { "files": ["toc.yml", "*.md"] }
    ],
    "resource": [
      { "files": ["images/**", "robots.txt"] }
    ],
    "dest": "_site",
    "template": ["default", "modern"],
    "sitemap": {
      "baseUrl": "https://xkqg.github.io/MatPlotLibNet/",
      "priority": 0.5,
      "changefreq": "weekly"
    },
    "globalMetadata": {
      "_appTitle": "MatPlotLibNet",
      "_appFooter": "MatPlotLibNet — matplotlib for .NET &bull; MIT License",
      "_enableSearch": true,
      "_disableContribution": false,
      "_gitContribute": {
        "repo": "https://github.com/xkqg/MatPlotLibNet",
        "branch": "main",
        "path": "docs"
      }
    }
  }
}
