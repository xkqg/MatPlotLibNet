<Project>

  <!-- Imported after every project file, so the version the project set is already known here. Fourteen packages
       share one release-notes sentence: written once, it cannot drift, and the deep link follows the version on
       its own. ReleasePackagingContractTests pins both halves against the changelog. -->
  <PropertyGroup>
    <ChangelogAnchor>$(Version.Replace('.',''))</ChangelogAnchor>
    <PackageReleaseNotes>MatPlotLibNet $(Version). What changed in this release, and in every release before it, is written out in the changelog: https://github.com/xkqg/MatPlotLibNet/blob/main/CHANGELOG.md#$(ChangelogAnchor)</PackageReleaseNotes>
  </PropertyGroup>

  <!-- A package that reads the internals of the packages it references (InternalsVisibleTo) works only with the build of them it
       was compiled against: an internal member is no promise, and a later release of the package it reads may move it, which a
       consumer would meet as a MissingMethodException at run time. Such a package sets DependsOnInternals, and its dependency on
       every package it references is written as exactly this version, [x.y.z], instead of the floor NuGet writes for a project
       reference. The packages ship together at one version, so the exact dependency is always there to be had.
       InternalsDependencyContractTests holds the list of packages that set it to the internals that are granted. -->
  <Target Name="DependOnReferencedPackagesExactly" AfterTargets="_GetProjectReferenceVersions" Condition="'$(DependsOnInternals)' == 'true'">
    <ItemGroup>
      <_ProjectReferencesWithVersions>
        <ProjectVersion>[%(ProjectVersion)]</ProjectVersion>
      </_ProjectReferencesWithVersions>
    </ItemGroup>
  </Target>

</Project>
