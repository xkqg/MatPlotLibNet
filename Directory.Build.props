<Project>

  <PropertyGroup>
    <Authors>H.P. Gansevoort</Authors>
    <Copyright>Copyright (c) 2026 H.P. Gansevoort</Copyright>
    <PackageProjectUrl>https://github.com/xkqg/MatPlotLibNet</PackageProjectUrl>

    <!-- One image for all fourteen packages. Without it every NuGet search row and every row of the Visual
         Studio package manager shows a placeholder. The file is drawn by the library itself — see sample 43 in
         Samples/MatPlotLibNet.Samples.Console — so it cannot drift away from what the library actually renders. -->
    <PackageIcon>icon.png</PackageIcon>
    <RepositoryUrl>https://github.com/xkqg/MatPlotLibNet</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);CS1591</NoWarn>

    <!-- One language version for every project, both TFMs — set here so no csproj repeats or drifts from it
         (same one-place pattern as SourceLinkVersion below). A per-project override used to pin core to 12
         specifically so a C#13/14-only feature could never compile on the net10.0 leg and then fail on net8.0;
         that pin is gone now that every project is explicitly on 14 instead of each TFM's own implicit default. -->
    <LangVersion>14</LangVersion>

    <!-- Repo-wide, non-Windows only: docfx passes the WPF block's TargetFramework as a GLOBAL property, and a
         global property spills onto that project's references. On the Linux Pages runner MatPlotLibNet and
         MatPlotLibNet.Skia then read as Windows-targeting and refuse with "To build a project targeting Windows
         on this operating system, set the EnableWindowsTargeting property to true" — after which docfx falls
         back to the raw ref assemblies and the WPF metadata dies on CS1704/CS0246. Setting it here rather than
         per-project means no project can be caught by that spill again. It only widens targeting-pack
         acceptance for non-runtime tasks; nothing runs differently on Windows. -->
    <EnableWindowsTargeting Condition=" '$(OS)' != 'Windows_NT' ">true</EnableWindowsTargeting>

    <!-- Deterministic & reproducible builds -->
    <Deterministic>true</Deterministic>
    <ContinuousIntegrationBuild Condition="'$(CI)' == 'true'">true</ContinuousIntegrationBuild>

    <!-- Source Link & symbol packages -->
    <PublishRepositoryUrl>true</PublishRepositoryUrl>
    <EmbedUntrackedSources>true</EmbedUntrackedSources>
    <DebugType>embedded</DebugType>
  </PropertyGroup>

  <!-- A pack is compared with the release before it: `dotnet pack` takes that package from nuget.org, compares the
       public API of every target framework it shipped and fails on a break (a removed or changed member, a
       missing target framework); an addition passes. Every package builds with GeneratePackageOnBuild, so a build
       is a pack and a break is caught by the build that makes it.

       The baseline is named HERE and nowhere else. The release moves it together with the version: it is the
       release just before the one being made, and ReleaseContractTests fails when it is not. The packages that
       opt out: the frozen Notebooks package (it never had that release) and the .NET tool package, which the SDK
       switches off by itself because a command line has no API to compare.

       Scoped to Src/ because that is where the packages are and nothing else is one: two samples are packable by
       default, a baseline for them would be looked up on nuget.org as a package that does not exist, and the
       project's own `IsPackable` is not yet known in this file. -->
  <PropertyGroup Condition="$(MSBuildProjectDirectory.StartsWith($([MSBuild]::NormalizeDirectory('$(MSBuildThisFileDirectory)', 'Src'))))">
    <EnablePackageValidation>true</EnablePackageValidation>
    <PackageValidationBaselineVersion>1.20.0</PackageValidationBaselineVersion>
  </PropertyGroup>

  <ItemGroup>
    <None Include="$(MSBuildThisFileDirectory)icon.png" Pack="true" PackagePath="\" Visible="false" />
  </ItemGroup>

  <!-- The one place the SourceLink version is written. Every project inherits the reference below, so none of them
       restates it (ReleaseContractTests.TheSourceLinkVersion_LivesInOnePlace holds that), and a bump is one edit.

       Pinned, not floating: CVE-2026-62900 names four bands of Microsoft.Build.Tasks.Git, the package SourceLink
       pulls: 8.0.0, 10.0.102-10.0.110, 10.0.200-10.0.204 and 10.0.300-10.0.301. The 8.0.0 and 10.0.200-10.0.204
       bands have no patched release inside them (the fix there is a newer SDK); 10.0.111 and 10.0.303 are the
       fixes of the other two. 10.0.402 lies above every band, so it is outside all four, and a floating range
       could drift back into one of them on its own. -->
  <PropertyGroup>
    <SourceLinkVersion>10.0.402</SourceLinkVersion>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.SourceLink.GitHub" Version="$(SourceLinkVersion)" PrivateAssets="All" />
  </ItemGroup>

</Project>
