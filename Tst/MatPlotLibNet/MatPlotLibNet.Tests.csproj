<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <OutputType>Exe</OutputType>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="xunit.v3" Version="4.*" />
    <!-- Jint hosts the embedded browser-interaction JS scripts inside test-process for
         behavioural assertions (Phase 1 of the v1.7.2 interaction-hardening plan).
         MIT-licensed, pure managed code — no native deps. -->
    <PackageReference Include="Jint" Version="4.*" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\Src\MatPlotLibNet\MatPlotLibNet.csproj" />
    <ProjectReference Include="..\..\Src\MatPlotLibNet.Geo\MatPlotLibNet.Geo.csproj" />
    <ProjectReference Include="..\..\Samples\MatPlotLibNet.Playground\MatPlotLibNet.Playground.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

  <ItemGroup>
    <!-- Golden-JSON serialization corpus (ChartSerializerGoldenCorpusTests) — copied next to the
         test assembly so AppContext.BaseDirectory-anchored reads find them at run time. -->
    <Content Include="Serialization\Golden\**\*.json" CopyToOutputDirectory="PreserveNewest" />
    <!-- What the published 1.23.0 wrote for a figure with four Y axes (YAxisContainerWireCompatTests): fixed bytes,
         never regenerated by the golden Theory's MPL_REGEN_GOLDEN. The SVG is what 1.23.0 drew for the same figure. -->
    <Content Include="Serialization\Compat\*.json;Serialization\Compat\*.svg" CopyToOutputDirectory="PreserveNewest" />
    <!-- Unicode's own conformance corpora for the bidi algorithm (BidiConformanceTests): 594 055 cases,
         checked in gzipped (1.7 MB instead of 14.8 MB) and streamed by the tests. Unicode 17.0.0. -->
    <Content Include="Rendering\Text\Ucd\*.gz" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>