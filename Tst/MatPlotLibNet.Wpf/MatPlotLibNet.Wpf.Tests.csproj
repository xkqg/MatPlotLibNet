<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- WPF, so Windows only — like the MAUI and Uno suites this one is in the solution and in nothing
         else: the CI runners are ubuntu and cannot build it. Unlike those two the package project needs no
         workload or multi-target pipeline, so it is referenced normally instead of having its sources
         compiled in. The TFM matches the SkiaSharp.Views.WPF floor the package itself sets. -->
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <UseWPF>true</UseWPF>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <OutputType>Exe</OutputType>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="xunit.v3" Version="4.*" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\Src\MatPlotLibNet.Wpf\MatPlotLibNet.Wpf.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
    <Using Include="MatPlotLibNet.Tests" />
  </ItemGroup>

  <ItemGroup>
    <!-- The doubles and the wait the core suite writes once: an animation source that counts its listeners and raises a frame on
         request, a handler that records, and a wait that fails when the condition never holds. -->
    <Compile Include="..\MatPlotLibNet\TestFixtures\FakeAnimationSource.cs" LinkBase="Shared" />
    <Compile Include="..\MatPlotLibNet\TestFixtures\RecordingChartEventHandler.cs" LinkBase="Shared" />
    <Compile Include="..\MatPlotLibNet\TestFixtures\Eventually.cs" LinkBase="Shared" />
    <Compile Include="..\MatPlotLibNet\TestFixtures\ServerInteractionProbe.cs" LinkBase="Shared" />
  </ItemGroup>

</Project>
