<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <OutputType>Exe</OutputType>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="xunit.v3" Version="4.*" />
    <PackageReference Include="NSubstitute" Version="6.*" />
    <PackageReference Include="Avalonia" Version="12.*" />
    <PackageReference Include="Avalonia.Skia" Version="12.*" />
    <PackageReference Include="SkiaSharp" Version="3.*" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\Src\MatPlotLibNet\MatPlotLibNet.csproj" />
    <ProjectReference Include="..\..\Src\MatPlotLibNet.Skia\MatPlotLibNet.Skia.csproj" />
    <!-- The package itself, not its sources linked in: the coverage collector records a module only while the process
         loads it, and a linked copy lives in this suite's own *.Tests.dll, which the runsettings leaves out. -->
    <ProjectReference Include="..\..\Src\MatPlotLibNet.Avalonia\MatPlotLibNet.Avalonia.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
    <Using Include="MatPlotLibNet.Tests" />
  </ItemGroup>

  <ItemGroup>
    <!-- The doubles and the wait the core suite writes once: an animation source that counts its listeners and raises a frame on
         request, a handler that records, and a wait that fails when the condition never holds. -->
    <Compile Include="..\MatPlotLibNet\TestFixtures\FakeAnimationSource.cs" LinkBase="Shared" />
    <Compile Include="..\MatPlotLibNet\TestFixtures\RecordingChartEventHandler.cs" LinkBase="Shared" />
    <Compile Include="..\MatPlotLibNet\TestFixtures\Eventually.cs" LinkBase="Shared" />
    <Compile Include="..\MatPlotLibNet\TestFixtures\ServerInteractionProbe.cs" LinkBase="Shared" />
    <Compile Include="..\MatPlotLibNet\TestFixtures\AnimationSourceReadback.cs" LinkBase="Shared" />
  </ItemGroup>

</Project>
