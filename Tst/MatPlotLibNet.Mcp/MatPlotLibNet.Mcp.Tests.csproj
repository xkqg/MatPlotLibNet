<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <OutputType>Exe</OutputType>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="xunit.v3" Version="4.*" />
    <PackageReference Include="NSubstitute" Version="6.*" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\Src\MatPlotLibNet.Mcp\MatPlotLibNet.Mcp.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- The composed-chart fixtures are public-API only; the core suite and this one read the same shapes. -->
    <Compile Include="..\MatPlotLibNet\Rendering\ComposedChartShapes.cs" LinkBase="Shared" />
    <Compile Include="..\MatPlotLibNet\Packaging\VerbFamilies.cs" LinkBase="Shared" />
    <!-- The drawn-property contract: every property a composed series draws must pass this reader too. -->
    <Compile Include="..\MatPlotLibNet\Serialization\DrawnSeriesFixtures.cs" LinkBase="Shared" />
    <!-- The same contract for what an axes draws besides its series: axes, legend, colour bar, grid, overlays. -->
    <Compile Include="..\MatPlotLibNet\Serialization\DrawnAxesFixtures.cs" LinkBase="Shared" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

</Project>
