<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <OutputType>Exe</OutputType>
    <IsPackable>false</IsPackable>
    <!-- Embed the Matplotlib fixture PNGs and JSONs as content so tests can resolve them relative to the output dir -->
    <CopyLocalLockFileAssemblies>true</CopyLocalLockFileAssemblies>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="xunit.v3" Version="4.*" />
    <PackageReference Include="SkiaSharp" Version="3.*" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\Src\MatPlotLibNet\MatPlotLibNet.csproj" />
    <ProjectReference Include="..\..\Src\MatPlotLibNet.Skia\MatPlotLibNet.Skia.csproj" />
    <ProjectReference Include="..\..\Src\MatPlotLibNet.Geo\MatPlotLibNet.Geo.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- The one place that finds the repository's root: every suite reads the folder from this file. -->
    <Compile Include="..\MatPlotLibNet\Packaging\RepositoryRoot.cs" LinkBase="Shared" />
    <Compile Include="..\MatPlotLibNet\Packaging\SourceFile.cs" LinkBase="Shared" />
    <Compile Include="..\MatPlotLibNet\TestFixtures\ThemeCases.cs" LinkBase="Shared" />
    <Compile Include="..\MatPlotLibNet\TestFixtures\SampleSurface.cs" LinkBase="Shared" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
    <Using Include="MatPlotLibNet.Tests.Packaging" />
  </ItemGroup>

  <!-- Copy fixture images (recursive: classic/ and v2/ subdirs) to output directory so tests can find them at runtime -->
  <ItemGroup>
    <Content Include="Fixtures\Matplotlib\**\*.png" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="Fixtures\Matplotlib\**\*.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <!-- The suite renders with Skia, so it brings the natives for every OS like the other hosts that render: on Linux it died
       with "Unable to load shared library 'libSkiaSharp'" before any picture was compared. -->
  <Import Project="..\..\SkiaNativeAssets.props" />

</Project>
