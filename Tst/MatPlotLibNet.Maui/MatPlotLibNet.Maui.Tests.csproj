<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <OutputType>Exe</OutputType>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="xunit.v3" Version="4.*" />
    <PackageReference Include="NSubstitute" Version="6.*" />
    <PackageReference Include="Microsoft.Maui.Graphics" Version="10.0.120" />
    <PackageReference Include="Microsoft.Maui.Controls" Version="10.0.120" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\Src\MatPlotLibNet\MatPlotLibNet.csproj" />
  </ItemGroup>

  <!-- Include MAUI source files directly to avoid multi-target dependency. Every source file of the package, in whatever
       folder, so a folder added to the package is under test and under the coverage gate without anyone remembering to
       list it: MatPlotLibNet.Maui itself has platform target frameworks and needs the MAUI workload to build, and this plain
       net10.0 suite does not. -->
  <ItemGroup>
    <Compile Include="..\..\Src\MatPlotLibNet.Maui\**\*.cs" Exclude="..\..\Src\MatPlotLibNet.Maui\obj\**;..\..\Src\MatPlotLibNet.Maui\bin\**" LinkBase="MauiSrc" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
    <Using Include="MatPlotLibNet.Tests" />
  </ItemGroup>

  <ItemGroup>
    <!-- The doubles and the wait the core suite writes once: an animation source that counts its listeners and raises a frame on
         request, a handler that records, and a wait that fails when the condition never holds. -->
    <Compile Include="..\MatPlotLibNet\TestFixtures\FakeAnimationSource.cs" LinkBase="Shared" />
    <Compile Include="..\MatPlotLibNet\TestFixtures\RecordingChartEventHandler.cs" LinkBase="Shared" />
    <Compile Include="..\MatPlotLibNet\TestFixtures\Eventually.cs" LinkBase="Shared" />
    <Compile Include="..\MatPlotLibNet\TestFixtures\ServerInteractionProbe.cs" LinkBase="Shared" />
    <Compile Include="..\MatPlotLibNet\TestFixtures\AnimationSourceReadback.cs" LinkBase="Shared" />
    <Compile Include="..\MatPlotLibNet\TestFixtures\DiagnosticsCapture.cs" LinkBase="Shared" />
    <Compile Include="..\MatPlotLibNet\TestFixtures\ContourFigures.cs" LinkBase="Shared" />
  </ItemGroup>

</Project>
