<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <OutputType>Exe</OutputType>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="xunit.v3" Version="4.*" />
    <PackageReference Include="SkiaSharp" Version="3.*" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\Src\MatPlotLibNet.Skia\MatPlotLibNet.Skia.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

  <ItemGroup>
    <!-- The composed charts the core suite holds to its promises, exported here with a missing value in their data. -->
    <Compile Include="..\MatPlotLibNet\Rendering\ComposedChartShapes.cs" LinkBase="Shared" />
    <!-- How the core suite reads the markup a figure draws: the start tags of an element and their attributes. -->
    <Compile Include="..\MatPlotLibNet\Rendering\SvgMarkupExtensions.cs" LinkBase="Shared" />
  </ItemGroup>

  <ItemGroup>
    <!-- A font the bundled set does not carry (Noto Sans Hebrew, SIL Open Font License, see Fonts\OFL-NotoSansHebrew.txt):
         the fixture for registering a font FILE, whose family must not collide with DejaVu Sans. -->
    <Content Include="Fonts\*.ttf" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="Fonts\OFL-*.txt" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <!-- The native libraries libSkiaSharp and libHarfBuzzSharp, for every OS: written once for every host that renders. -->
  <Import Project="..\..\SkiaNativeAssets.props" />

</Project>
