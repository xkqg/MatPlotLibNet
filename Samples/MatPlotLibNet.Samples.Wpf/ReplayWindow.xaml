<Window x:Class="MatPlotLibNet.Samples.Wpf.ReplayWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:mpl="clr-namespace:MatPlotLibNet.Wpf;assembly=MatPlotLibNet.Wpf"
        Title="MatPlotLibNet — Replay timeline" Height="520" Width="900">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <StackPanel Orientation="Horizontal" Margin="8" Grid.Row="0">
            <Button x:Name="PlayButton"  Content="Play"            Margin="0,0,8,0" Padding="12,4" Click="OnPlayClicked" />
            <Button x:Name="FirstButton" Content="First 30 s"      Margin="0,0,8,0" Padding="12,4" Click="OnFirstClicked" />
            <Button x:Name="AllButton"   Content="Whole recording" Margin="0,0,8,0" Padding="12,4" Click="OnAllClicked" />
            <TextBlock x:Name="PositionText" VerticalAlignment="Center" Margin="16,0,0,0" />
        </StackPanel>

        <mpl:MplChartControl x:Name="Chart" Grid.Row="1" IsInteractive="True" />
    </Grid>
</Window>
