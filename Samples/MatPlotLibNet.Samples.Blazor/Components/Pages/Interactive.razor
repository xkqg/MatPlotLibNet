@page "/interactive"
@using MatPlotLibNet.AspNetCore
@inject FigureRegistry Registry
@implements IDisposable

<h1>Bidirectional SignalR Demo</h1>
<p>
    Scroll wheel over the chart to zoom. Drag to pan. Click the chart and press
    <kbd>Home</kbd> to go back to the view the chart started with. Every gesture round-trips to the .NET server
    through the chart's own connection (<code>ChartHub.OnZoom</code> / <code>OnPan</code> / <code>OnReset</code>), which
    mutates the authoritative <code>Figure</code> via <code>FigureRegistry</code> and publishes the updated
    SVG back. Open the page in a second window to see the other viewer's pointer.
</p>

<MplLiveChart ChartId="@ChartId" InitialFigure="_figure" />

@code {
    private const string ChartId = "blazor-interactive";
    private Figure _figure = default!;

    protected override void OnInitialized()
    {
        var xs = Enumerable.Range(0, 150).Select(i => i * 0.05).ToArray();
        var ys = xs.Select(x => Math.Sin(x) * Math.Exp(-0.1 * x)).ToArray();

        _figure = Plt.Create()
            .WithTitle("Damped sine — server-authoritative zoom/pan")
            .WithSize(900, 450)
            .WithTheme(Theme.MatplotlibV2)
            .Plot(xs, ys, line => { line.Color = Css4Colors.Crimson; line.Label = "sin(x)·e^(-0.1x)"; })
            .WithServerInteraction(ChartId, i => i.All().EnableViewerCursors())
            .Build();

        _figure.SubPlots[0].XAxis.Min = xs[0];
        _figure.SubPlots[0].XAxis.Max = xs[^1];
        _figure.SubPlots[0].YAxis.Min = -1.0;
        _figure.SubPlots[0].YAxis.Max = 1.0;

        Registry.Register(ChartId, _figure);
    }

    public void Dispose()
    {
        _ = Registry.UnregisterAsync(ChartId);
    }
}
