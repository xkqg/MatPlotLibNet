<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFrameworks>net10.0;net8.0</TargetFrameworks>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <Version>1.31.0</Version>
    <PackageId>MatPlotLibNet.Skia</PackageId>
    <Description>PNG and PDF export for MatPlotLibNet charts using SkiaSharp.</Description>
    <PackageTags>matplotlib;charting;plotting;charts;visualization;png;pdf;export;skiasharp</PackageTags>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <GeneratePackageOnBuild>true</GeneratePackageOnBuild>
    <!-- Reads internals of the packages it references (InternalsVisibleTo), so it depends on each at exactly this
         version (Directory.Build.targets). -->
    <DependsOnInternals>true</DependsOnInternals>
  </PropertyGroup>

  <ItemGroup>
    <!-- SkiaSharp stays on 3.x, and with it SkiaSharp.HarfBuzz 3.x and HarfBuzzSharp 8.x. The SkiaSharp major is
         part of this package's contract: its public surface takes SkiaSharp types (SkiaRenderContext wraps an
         SKCanvas, TextShaper.Shape takes an SKFont and an SKShaper), so a consumer's own SkiaSharp has to be the
         one this package was built on. 4.x (4.153.1, with HarfBuzzSharp 14.2) is one release line with the WPF and
         Uno view packages, and at 4.x those two ship assets for net9.0 and net10.0 only. MatPlotLibNet.Wpf and
         MatPlotLibNet.Uno target net8.0 and cannot follow: measured on a net8.0 project, SkiaSharp.Views.WPF
         4.153.1 restores its .NET Framework build and OpenTK 3 with three NU1701 warnings, and
         SkiaSharp.Views.Uno.WinUI 4.153.1 fails restore with NU1202. Avalonia.Skia 12.1.4, the newest 12.x, is
         built on SkiaSharp 3.119.4. The family moves together, and only after Wpf and Uno leave net8.0;
         DependencyMajorContractTests keeps it on one major and says when the reason is gone. -->
    <PackageReference Include="SkiaSharp" Version="3.*" />
    <!-- Text shaping. SkiaSharp.HarfBuzz follows SkiaSharp's version line and pins the HarfBuzzSharp it was
         built against (8.3.1.5 for 3.119), so this is the one reference; the native libHarfBuzzSharp comes from
         per-platform HarfBuzzSharp.NativeAssets packages that a HOST references — the test project and the MCP
         tool do, at that exact 8.3.1.5, because HarfBuzzSharp has no 3.x line to float in. -->
    <PackageReference Include="SkiaSharp.HarfBuzz" Version="3.*" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\MatPlotLibNet\MatPlotLibNet.csproj" />
  </ItemGroup>

  <ItemGroup>
    <None Include="README.md" Pack="true" PackagePath="\" />
    <None Include="..\..\LICENSE" Pack="true" PackagePath="\" />
    <!-- The licences of the third-party files and libraries this package carries: it is what MIT, BSD-3-Clause, Apache-2.0 and the font licence ask to travel with a copy. -->
    <None Include="THIRD-PARTY-NOTICES.md" Pack="true" PackagePath="\" />
  </ItemGroup>

  <!-- Bundle DejaVu Sans TTF files (copied from matplotlib's mpl-data/fonts/ttf/) so
       Skia text rendering uses the IDENTICAL font matplotlib uses, regardless of
       what the host OS has installed. Without this, on Windows Skia falls back to
       Arial, which has different metrics and produces visibly smaller text. -->
  <ItemGroup>
    <EmbeddedResource Include="Fonts\DejaVuSans.ttf" />
    <EmbeddedResource Include="Fonts\DejaVuSans-Bold.ttf" />
    <EmbeddedResource Include="Fonts\DejaVuSans-Oblique.ttf" />
    <EmbeddedResource Include="Fonts\DejaVuSans-BoldOblique.ttf" />
    <!-- matplotlib's math font set 'dejavusans' (the default style) sets its large operators in this face. -->
    <EmbeddedResource Include="Fonts\DejaVuSansDisplay.ttf" />
  </ItemGroup>

  <!-- The Computer Modern faces of matplotlib's math font set 'cm' (mathtext.fontset under the classic style), the BaKoMa TrueType
       fonts as matplotlib ships them in mpl-data/fonts/ttf: the faces MathFontSet.ComputerModern sets math in. A face no set reads
       (cmss10: there is no \mathsf) is not packed. Their licence travels in THIRD-PARTY-NOTICES.md. -->
  <ItemGroup>
    <EmbeddedResource Include="Fonts\cmr10.ttf" />
    <EmbeddedResource Include="Fonts\cmmi10.ttf" />
    <EmbeddedResource Include="Fonts\cmti10.ttf" />
    <EmbeddedResource Include="Fonts\cmb10.ttf" />
    <EmbeddedResource Include="Fonts\cmsy10.ttf" />
    <EmbeddedResource Include="Fonts\cmex10.ttf" />
    <EmbeddedResource Include="Fonts\cmtt10.ttf" />
  </ItemGroup>

  <!-- The STIX faces matplotlib's math font sets 'cm' and 'dejavusans' take what they have no glyph for from (StixFonts, StixSansFonts),
       as matplotlib ships them in mpl-data/fonts/ttf (SIL Open Font License; the licence travels in THIRD-PARTY-NOTICES.md): the faces
       StixFallback sets those characters in, and the four sizes of delimiter and radical sign it takes from them. The bold and
       bold-italic non-Unicode faces, the bold-italic general face and the fifth size are not packed: no character of the library's
       grammar is set in them. -->
  <ItemGroup>
    <EmbeddedResource Include="Fonts\STIXGeneral.ttf" />
    <EmbeddedResource Include="Fonts\STIXGeneralItalic.ttf" />
    <EmbeddedResource Include="Fonts\STIXGeneralBol.ttf" />
    <EmbeddedResource Include="Fonts\STIXNonUni.ttf" />
    <EmbeddedResource Include="Fonts\STIXNonUniIta.ttf" />
    <EmbeddedResource Include="Fonts\STIXSizOneSymReg.ttf" />
    <EmbeddedResource Include="Fonts\STIXSizTwoSymReg.ttf" />
    <EmbeddedResource Include="Fonts\STIXSizThreeSymReg.ttf" />
    <EmbeddedResource Include="Fonts\STIXSizFourSymReg.ttf" />
  </ItemGroup>
</Project>
