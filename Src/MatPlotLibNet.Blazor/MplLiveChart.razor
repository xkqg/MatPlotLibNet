@namespace MatPlotLibNet.Blazor

@implements IAsyncDisposable
@inject NavigationManager Navigation

<div class="mpl-chart mpl-live @CssClass">
    @((MarkupString)_svgContent)
</div>

@code {
    [Parameter, EditorRequired] public string ChartId { get; set; } = default!;
    [Parameter] public string HubUrl { get; set; } = "/charts-hub";
    [Parameter] public string? CssClass { get; set; }
    [Parameter] public Figure? InitialFigure { get; set; }
    /// <summary>Optional subscription client — exposed so tests can inject a mock
    /// and so host apps can share one connection across components. When null
    /// (default), the component creates its own <see cref="ChartSubscriptionClient"/>.
    /// Phase J.1 of v1.7.2 follow-on plan.</summary>
    [Parameter] public IChartSubscriptionClient? Client { get; set; }

    private IChartSubscriptionClient _client = default!;
    private string _svgContent = string.Empty;
    private bool _ownsClient;

    protected override void OnInitialized()
    {
        _ownsClient = Client is null;
        _client = Client ?? new ChartSubscriptionClient();
    }

    protected override void OnParametersSet()
    {
        if (InitialFigure is not null && string.IsNullOrEmpty(_svgContent))
            _svgContent = ChartServices.SvgRenderer.Render(InitialFigure);
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender) return;

        _client.OnSvgUpdated((id, svg) =>
        {
            if (id == ChartId)
            {
                _svgContent = svg;
                InvokeAsync(StateHasChanged);
            }
            return Task.CompletedTask;
        });

        _client.OnChartUpdated((id, json) =>
        {
            if (id == ChartId)
            {
                var figure = ChartServices.Serializer.FromJson(json);
                _svgContent = ChartServices.SvgRenderer.Render(figure);
                InvokeAsync(StateHasChanged);
            }
            return Task.CompletedTask;
        });

        await _client.ConnectAsync(ResolveHubUrl());
        await _client.SubscribeAsync(ChartId);
    }

    /// <summary>SignalR needs an absolute HTTP-family URI, so a rooted <see cref="HubUrl"/> — the component's
    /// own default — is resolved against the app's base URI. A hub URL that already names an http/https/ws/wss
    /// host is passed through untouched (a hub served from another origin).
    /// <para><b>Why the scheme is checked and not merely "is it absolute".</b> Rooted-path URI parsing is
    /// platform-dependent: <c>Uri.TryCreate("/charts-hub", UriKind.Absolute, out _)</c> returns
    /// <see langword="false"/> on Windows but <see langword="true"/> on Unix, where it happily yields
    /// <c>file:///charts-hub</c>. An absoluteness test therefore sends a Linux-hosted app off to connect to a
    /// file URI — silently, because SignalR is handed a URI that is perfectly well-formed and simply points
    /// nowhere. Only an HTTP-family scheme means "the caller supplied a real hub address".</para></summary>
    private string ResolveHubUrl()
    {
        bool parsed = Uri.TryCreate(HubUrl, UriKind.Absolute, out var absolute);

        if (parsed && absolute!.Scheme is "http" or "https" or "ws" or "wss")
        {
            return absolute.ToString();   // a real hub address, possibly on another origin
        }

        // Everything else is a path that must hang off the app's own base URI. On Unix that includes the
        // file:// URI a rooted path silently degrades into — so take its PATH and resolve that, rather than
        // handing NavigationManager a string that still carries a scheme (it would keep the scheme, and the
        // app would go looking for its hub on the filesystem).
        string path = parsed ? absolute!.PathAndQuery : HubUrl;
        return Navigation.ToAbsoluteUri(path).ToString();
    }

    public async ValueTask DisposeAsync()
    {
        // BUG B4: an injected (unowned) Client belongs to the DI container/host app —
        // only dispose a client this component created itself.
        if (_ownsClient)
            await _client.DisposeAsync();
    }
}
