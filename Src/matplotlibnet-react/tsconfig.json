{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ES2022",
    "moduleResolution": "node",
    "declaration": true,
    "strict": true,
    "esModuleInterop": true,
    "jsx": "react-jsx",
    "outDir": "./dist",
    "rootDir": "./src",
    "lib": ["ES2022", "DOM"],
    "baseUrl": ".",
    "paths": { "@matplotlibnet/client": ["../matplotlibnet-client/dist/index.d.ts"] }
  },
  "include": ["src/**/*"],
  "exclude": ["src/**/*.test.*"]
